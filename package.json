{
  "name": "nsm-framework",
  "private": true,
  "version": "0.1.0",
  "description": "Nostr State Machine Framework - Building deterministic, multi-user applications on Nostr",
  "keywords": ["nostr", "state-machine", "xstate", "framework", "collaboration"],
  "packageManager": "bun@1.2.21",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "install:all": "bun install --frozen-lockfile",
    "test:watch": "turbo run test:watch"
  },
  "devDependencies": {
    "turbo": "^1.13.0",
    "typescript": "^5.4.0",
    "bun-types": "^1.2.21",
    "@types/node": "^20.11.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  }
}