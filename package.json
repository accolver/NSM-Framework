{
  "name": "nsm-framework",
  "private": true,
  "version": "0.1.0",
  "description": "Nostr State Machine Framework - Building deterministic, multi-user applications on Nostr",
  "keywords": [
    "nostr",
    "state-machine",
    "xstate",
    "framework",
    "collaboration"
  ],
  "packageManager": "bun@1.2.21",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:analyze": "turbo run build && node tools/bundle-analyzer.js",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:comprehensive": "./run-all-tests.sh",
    "test:nsm-only": "cd packages/nsm-core && bun test",
    "test:collective-only": "cd .claude-collective && npx vitest run",
    "test:performance": "cd tests/performance && bun run-performance-tests.ts",
    "test:performance:quick": "cd tests/performance && bun run-performance-tests.ts --skip-long-running",
    "test:performance:baselines": "cd tests/performance && bun run-performance-tests.ts --generate-baselines",
    "test:performance:state-machine": "cd tests/performance && bun run-performance-tests.ts --suite 'state machine'",
    "test:performance:network": "cd tests/performance && bun run-performance-tests.ts --suite 'network'",
    "test:performance:load": "cd tests/performance && bun run-performance-tests.ts --suite 'load'",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "install:all": "bun install --frozen-lockfile",
    "test:watch": "turbo run test:watch",
    "prepare": "husky",
    "docs:dev": "cd docs && mintlify dev",
    "docs:build": "cd docs && mintlify build",
    "docs:check": "cd docs && mintlify broken-links",
    "analyze:bundles": "node tools/bundle-analyzer.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "bun-types": "^1.2.21",
    "esbuild": "^0.25.9",
    "eslint": "^8.57.0",
    "events": "^3.3.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "module": "^1.2.5",
    "prettier": "^3.2.5",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  }
}
