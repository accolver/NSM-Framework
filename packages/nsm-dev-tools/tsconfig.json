{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "node",
    "allowImportingTsExtensions": false,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@nsm/core": ["../nsm-core/dist"],
      "@nsm/core/*": ["../nsm-core/dist/*"],
      "@nsm/client": ["../nsm-client/dist"],
      "@nsm/client/*": ["../nsm-client/dist/*"],
      "@nsm/client-sdk": ["../nsm-client-sdk/dist"],
      "@nsm/client-sdk/*": ["../nsm-client-sdk/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.spec.ts", "**/*.test.tsx", "**/__tests__/**/*", "src/test-setup.ts"]
}