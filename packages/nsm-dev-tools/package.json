{
  "name": "@nsm/dev-tools",
  "version": "0.1.0",
  "description": "NSM Development Tools - Utilities for NSM development",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:ts": "tsc --build",
    "build:bundle": "bun build src/index.ts --format esm --outfile dist/index.mjs && bun build src/index.ts --format cjs --outfile dist/index.js",
    "dev": "tsc --build --watch --pretty false",
    "test": "bun test --preload ./src/test-setup.ts",
    "test:watch": "bun test --watch --preload ./src/test-setup.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nsm/core": "workspace:*",
    "@nsm/client-sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "xstate": "^5.19.0",
    "@xstate/react": "^4.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/user-event": "^14.5.0",
    "happy-dom": "^12.10.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
