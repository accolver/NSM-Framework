{
  "name": "@nsm/client",
  "version": "0.1.0",
  "description": "NSM Client library for app integration",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "dev": "bun --silent test --watch",
    "typecheck": "bun tsc --noEmit"
  },
  "dependencies": {
    "@nsm/core": "workspace:*",
    "@nsm/crypto": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.0.0",
    "typescript": "^5.0.0"
  }
}
