    "dev": "bun --silent test --watch",
    "typecheck": "bun tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "^1.0.0",
    "@types/react": "^18.2.37",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "xstate": ">=5.0.0"
  },
  "keywords": [
    "nostr",
    "state-machine",
