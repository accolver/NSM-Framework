{
  "name": "@nsm/core",
  "version": "0.1.0",
  "description": "Core NSM protocol implementation and TypeScript interfaces",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
