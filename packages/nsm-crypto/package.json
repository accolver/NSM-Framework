{
  "name": "@nsm/crypto",
  "version": "0.1.0",
  "description": "Cryptographic verification utilities for the NSM framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b --force",
    "test": "bun test",
    "dev": "bun --silent test --watch",
    "typecheck": "bun tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@nsm/core": "workspace:*",
    "@noble/secp256k1": "^2.1.0",
    "@noble/hashes": "^1.4.0",
    "nostr-tools": "^2.10.4"
  },
  "devDependencies": {
    "@types/bun": "^1.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "nostr",
    "cryptography",
    "secp256k1",
    "schnorr",
    "blossom",
    "nsm"
  ],
  "author": "",
  "license": "MIT"
}
