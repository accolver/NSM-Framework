{
  "name": "nsm-browser",
  "version": "0.1.0",
  "description": "NSM Browser - Web UI for browsing and publishing Nostr State Machines",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "vite --port 5175",
    "dev": "vite --port 5175",
    "build": "vite build",
    "preview": "vite preview --port 5175",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "lint": "eslint src/**/*.{ts,tsx}",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nostr-dev-kit/ndk": "^2.14.35",
    "@nsm/client": "workspace:*",
    "@nsm/core": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.3.1",
    "happy-dom": "^12.10.3",
    "typescript": "^5.4.0",
    "vite": "^4.5.0",
    "vitest": "^1.0.0"
  }
}