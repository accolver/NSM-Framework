{
  "name": "nsm-poc-wordle",
  "version": "0.1.0",
  "description": "Wordle Proof of Concept - NSM application demo",
  "private": true,
  "scripts": {
    "build": "bun run build:app",
    "build:app": "bun build src/index.tsx --outdir dist --target browser --format esm --splitting",
    "dev": "bun --watch run src/index.tsx",
    "dev:serve": "bun build src/index.tsx --outdir dist --target browser --format esm --watch & python3 -m http.server 8000",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint src/**/*.{ts,tsx}",
    "format": "prettier --write src/**/*.{ts,tsx}",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nsm/core": "workspace:*",
    "@nsm/client": "workspace:*",
    "@nsm/client-sdk": "workspace:*",
    "@xstate/react": "^4.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xstate": "^5.19.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "happy-dom": "^12.10.3",
    "typescript": "^5.4.0"
  }
}