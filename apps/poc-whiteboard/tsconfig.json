{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "composite": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "types": ["bun-types", "@testing-library/jest-dom", "vitest/globals"]
  },
  "include": ["src/**/*", "src/test-types.d.ts"],
  "exclude": ["dist", "node_modules"],
  "references": [
    { "path": "../../packages/nsm-core" },
    { "path": "../../packages/nsm-client-sdk" },
    { "path": "../../packages/nsm-client" }
  ]
}